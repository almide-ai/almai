// sampling_wire_test — observe the REQUEST BODY, not the response.
//
// almide-ai/almai#7: `cloudflare.almd` declared a CallOptions full of
// sampling knobs and put `{"messages": [...]}` on the wire. Every existing
// test passed throughout, because a test that only checks the call
// succeeded cannot see a field that was never sent — the model answers
// perfectly well at the vendor's default temperature.
//
// So these tests read the body. `build_body` is pure for exactly this
// reason: the assertion is on the bytes that would go out.

import self as almai
import self.providers.cloudflare as cf
import self.providers.openai as oai
import json

// ── The regression itself ──

test "cloudflare body carries the sampling options it was given" {
  let opts = almai.defaults()
    |> almai.with_temperature(0.35)
    |> almai.with_top_p(0.9)
    |> almai.with_max_tokens(1234)
    |> almai.with_seed(424242)
  let s = json.stringify(cf.build_body([almai.user("hi")], opts))
  assert(string.contains(s, "\"temperature\":0.35"), "temperature must reach the wire")
  assert(string.contains(s, "\"top_p\":0.9"), "top_p must reach the wire")
  assert(string.contains(s, "\"max_tokens\":1234"), "max_tokens must reach the wire")
  assert(string.contains(s, "\"seed\":424242"), "seed must reach the wire")
}

test "cloudflare body is not messages-only (the #7 shape)" {
  // The pre-fix body was exactly {"messages":[...]}. Pin that it cannot
  // come back: with defaults, the sampling fields are still present.
  let s = json.stringify(cf.build_body([almai.user("hi")], almai.defaults()))
  assert(string.contains(s, "\"messages\""), "messages still present")
  assert(string.contains(s, "\"temperature\""), "temperature present at defaults")
  assert(string.contains(s, "\"top_p\""), "top_p present at defaults")
  assert(string.contains(s, "\"max_tokens\""), "max_tokens present at defaults")
}

test "the measurement default reaches the wire as 0, not the vendor's 0.6" {
  // Cloudflare's documented default temperature is 0.6. Omitting the field
  // is NOT neutral — it is 0.6. The trailing comma keeps this from matching
  // "temperature":0.35 and friends.
  let s = json.stringify(cf.build_body([almai.user("hi")], almai.defaults()))
  assert(string.contains(s, "\"temperature\":0,"), "defaults() must put temperature 0 on the wire")
}

// ── Seed: unset must not look like set ──

test "cloudflare omits seed when it was never asked for" {
  let s = json.stringify(cf.build_body([almai.user("hi")], almai.defaults()))
  assert(not string.contains(s, "\"seed\""), "an unset seed must not be invented")
}

test "seed 0 is the unset sentinel, not a seed" {
  // Cloudflare's valid range is 1..=9_999_999_999, so 0 can never be real.
  let opts = almai.defaults() |> almai.with_seed(0)
  let s = json.stringify(cf.build_body([almai.user("hi")], opts))
  assert(not string.contains(s, "\"seed\""), "seed 0 means unset")
  assert_eq(cf.sends_seed(opts), false)
}

// ── The echo may not over-claim ──
//
// This is the half that keeps "the model ignored it" distinguishable from
// "we honoured it": whatever LLMResponse.sampling reports as sent must
// actually be in the body, and whatever it reports as unsent must not be.

test "cloudflare echo agrees with the body it built (seed set)" {
  let opts = almai.defaults() |> almai.with_seed(7) |> almai.with_temperature(0.2)
  let s = json.stringify(cf.build_body([almai.user("hi")], opts))
  let e = cf.sampling_of(opts)
  assert_eq(e.seed_sent, true)
  assert_eq(e.seed, 7)
  assert_eq(string.contains(s, "\"seed\":7"), e.seed_sent)
  assert_eq(e.temperature_sent, true)
  assert_eq(e.temperature, 0.2)
  assert_eq(string.contains(s, "\"temperature\":0.2"), e.temperature_sent)
  assert_eq(e.max_tokens_sent, true)
  assert_eq(e.top_p_sent, true)
}

test "cloudflare echo agrees with the body it built (seed unset)" {
  let opts = almai.defaults()
  let s = json.stringify(cf.build_body([almai.user("hi")], opts))
  let e = cf.sampling_of(opts)
  // Both false: the body has no seed and the echo does not pretend it has.
  assert_eq(e.seed_sent, false)
  assert_eq(string.contains(s, "\"seed\""), e.seed_sent)
  assert_eq(e.seed, 0)
}

test "openai echo does not claim the options it never sends" {
  // openai.build_body sends max_tokens + temperature and neither top_p nor
  // seed. The echo has to say so, or a manifest reading `sampling` would
  // report a pinned sampler on a lane that has none.
  let opts = almai.defaults() |> almai.with_seed(7) |> almai.with_top_p(0.9)
  let s = json.stringify(oai.build_body("gpt-4o", [almai.user("hi")], opts, false))
  let e = oai.sampling_of(opts)
  assert_eq(e.seed_sent, false)
  assert_eq(string.contains(s, "\"seed\""), e.seed_sent)
  assert_eq(e.top_p_sent, false)
  assert_eq(string.contains(s, "\"top_p\""), e.top_p_sent)
  assert_eq(e.temperature_sent, true)
  assert(string.contains(s, "\"temperature\""), "openai does send temperature")
}

// ── The default response reports nothing sent ──

test "a provider that fills nothing in reports nothing sent" {
  let r = LLMResponse {
    content: "hi", model: "m",
    usage: Usage { prompt_tokens: 0, completion_tokens: 0, total_tokens: 0 },
    finish_reason: "stop", tool_calls: [], sampling: Sampling { },
  }
  assert_eq(r.sampling.seed_sent, false)
  assert_eq(r.sampling.temperature_sent, false)
  assert_eq(r.sampling.max_tokens_sent, false)
  assert_eq(r.sampling.top_p_sent, false)
}

test "with_seed records the seed in CallOptions" {
  assert_eq((almai.defaults() |> almai.with_seed(9999999999)).seed, 9999999999)
  assert_eq(almai.defaults().seed, 0)
}
