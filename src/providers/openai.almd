// almai.providers.openai — OpenAI-compatible (OpenAI, OpenRouter)

import env
import http
import json
import llm

type ToolCall = { id: String, name: String, arguments: String }
type Message = {
  role: String,
  content: String,
  tool_call_id: String = "",
  tool_calls: List[ToolCall] = [],
}
type LLMResponse = { content: String, model: String, usage: Usage, finish_reason: String, tool_calls: List[ToolCall], sampling: Sampling }
type Sampling = {
  temperature_sent: Bool = false,
  temperature: Float = 0.0,
  top_p_sent: Bool = false,
  top_p: Float = 0.0,
  max_tokens_sent: Bool = false,
  max_tokens: Int = 0,
  seed_sent: Bool = false,
  seed: Int = 0,
}
type Usage = { prompt_tokens: Int, completion_tokens: Int, total_tokens: Int }
type Tool = { name: String, description: String, parameters: Value }
type CallOptions = { max_tokens: Int, temperature: Float, top_p: Float, system: String, stop: List[String], tools: List[Tool], json_mode: Bool, seed: Int = 0 }

// What `build_body` actually writes — not what CallOptions offers. This
// provider sends max_tokens and temperature and nothing else from the
// sampling set, so `top_p_sent` / `seed_sent` are false and a caller's
// manifest says so instead of quietly implying a pinned sampler.
//
// OpenAI Chat Completions does accept `seed` and `top_p`; teaching this
// provider to send them is a separate change, because build_body is shared
// with the openrouter and groq lanes and would move their numbers too.
fn sampling_of(opts: CallOptions) -> Sampling =
  Sampling {
    temperature_sent: true, temperature: opts.temperature,
    max_tokens_sent: true, max_tokens: opts.max_tokens,
  }

// Emit a single tool_call as the OpenAI Chat Completions wire shape:
//   {"id": "...", "type": "function", "function": {"name": "...", "arguments": "..."}}
fn tool_call_to_json(tc: ToolCall) -> Value =
  value.object([
    ("id", value.string(tc.id)),
    ("type", value.string("function")),
    ("function", value.object([
      ("name", value.string(tc.name)),
      ("arguments", value.string(tc.arguments)),
    ])),
  ])

fn message_to_json(m: Message) -> Value = {
  // Base shape — every message has role + content
  let base = [("role", value.string(m.role)), ("content", value.string(m.content))]
  // role:"assistant" with tool_calls → emit `tool_calls` array
  let with_tool_calls = if m.role == "assistant" and not list.is_empty(m.tool_calls) then
    base + [("tool_calls", value.array(list.map(m.tool_calls, (tc) => tool_call_to_json(tc))))]
  else base
  // role:"tool" requires `tool_call_id` to correlate with the assistant call
  let with_id = if m.role == "tool" and m.tool_call_id != "" then
    with_tool_calls + [("tool_call_id", value.string(m.tool_call_id))]
  else with_tool_calls
  value.object(with_id)
}

fn messages_to_json(msgs: List[Message]) -> Value =
  value.array(list.map(msgs, (m) => message_to_json(m)))

fn tools_to_json(ts: List[Tool]) -> Value =
  value.array(list.map(ts, (t) =>
    value.object([("type", value.string("function")), ("function", value.object([
      ("name", value.string(t.name)), ("description", value.string(t.description)), ("parameters", t.parameters)]))])))

fn parse_tool_calls(msg: Value) -> List[ToolCall] =
  value.get_array(msg, "tool_calls") ?? []
    |> list.filter_map((tc) => {
      let id = value.get_string(tc, "id") ?? ""
      let func = value.get(tc, "function") ?? value.null()
      let name = value.get_string(func, "name") ?? ""
      let args = value.get_string(func, "arguments") ?? "{}"
      if name != "" then some(ToolCall { id: id, name: name, arguments: args }) else none
    })

fn parse_usage(v: Value) -> Usage = {
  let u = value.get(v, "usage") ?? value.null()
  Usage { prompt_tokens: value.get_int(u, "prompt_tokens") ?? 0,
    completion_tokens: value.get_int(u, "completion_tokens") ?? 0,
    total_tokens: value.get_int(u, "total_tokens") ?? 0 }
}

effect fn post_json(url: String, body: Value, headers: Map[String, String]) -> Result[Value, String] =
  match http.request("POST", url, json.stringify(body), map.to_list(headers)) {
    err(e) => err("http: " + e)
    ok(raw) => match json.parse(raw) {
      err(e) => err("json: " + e + " raw: " + string.take(raw, 200))
      ok(parsed) => match value.get(parsed, "error") |> option.flat_map((e) => value.get_string(e, "message")) {
        some(msg) => err("api: " + msg)
        none => ok(parsed)
      }
    }
  }

// Build the request body shared by streaming + non-streaming paths.
fn build_body(model: String, msgs: List[Message], opts: CallOptions, stream: Bool) -> Value = {
  let sys_msgs = if opts.system != "" then [Message { role: "system", content: opts.system }] else []
  let all_msgs = sys_msgs + msgs
  let fields = [("model", value.string(model)), ("messages", messages_to_json(all_msgs)),
    ("max_tokens", value.int(opts.max_tokens)), ("temperature", value.float(opts.temperature))]
  let fields = if not list.is_empty(opts.tools) then fields + [("tools", tools_to_json(opts.tools))] else fields
  let fields = if opts.json_mode then fields + [("response_format", value.object([("type", value.string("json_object"))]))] else fields
  let fields = if not list.is_empty(opts.stop) then fields + [("stop", value.array(list.map(opts.stop, (s) => value.string(s))))] else fields
  let fields = if stream then fields + [("stream", value.bool(true))] else fields
  value.object(fields)
}

effect fn call(base_url: String, api_key: String, model: String, msgs: List[Message], opts: CallOptions) -> Result[LLMResponse, String] = {
  let body = build_body(model, msgs, opts, false)
  match post_json(base_url + "/chat/completions", body, ["Authorization": "Bearer " + api_key, "Content-Type": "application/json"]) {
    err(e) => err(e)
    ok(parsed) => {
      let choice = option.flat_map(value.get_array(parsed, "choices"), (cs) => list.first(cs)) ?? value.null()
      let msg = value.get(choice, "message") ?? value.null()
      ok(LLMResponse { content: string.trim(value.get_string(msg, "content") ?? ""),
        model: value.get_string(parsed, "model") ?? "", usage: parse_usage(parsed),
        finish_reason: value.get_string(choice, "finish_reason") ?? "stop", tool_calls: parse_tool_calls(msg),
        sampling: sampling_of(opts) })
    }
  }
}

// Streaming call. Routes through package almide/llm's
// `llm.openai_streaming_call` (the stdlib's `http.openai_streaming_call` until
// dialect epoch 14), which owns the SSE parsing and delivers each new
// `delta.content` fragment to `on_text_delta` as it arrives. Returns a
// fully assembled LLMResponse on completion (content / tool_calls /
// usage all concatenated server-side).
//
// Use this in REPLs / agents that want responses to feel live. For
// agents that only need the final aggregate, the non-streaming `call`
// is simpler.
effect fn call_streaming(
  base_url: String,
  api_key: String,
  model: String,
  msgs: List[Message],
  opts: CallOptions,
  on_text_delta: (String) -> Unit,
) -> Result[LLMResponse, String] = {
  let body_json = json.stringify(build_body(model, msgs, opts, true))
  match llm.openai_streaming_call(base_url, api_key, body_json, on_text_delta) {
    err(e) => err("streaming: " + e)
    ok(raw) => match json.parse(raw) {
      err(e) => err("streaming: parse aggregate: " + e)
      ok(parsed) => {
        let tool_calls_arr = value.get_array(parsed, "tool_calls") ?? []
        let tool_calls = tool_calls_arr |> list.filter_map((tc) => {
          let id = value.get_string(tc, "id") ?? ""
          let name = value.get_string(tc, "name") ?? ""
          let args = value.get_string(tc, "arguments") ?? "{}"
          if name != "" then some(ToolCall { id: id, name: name, arguments: args }) else none
        })
        let usage_obj = value.get(parsed, "usage") ?? value.null()
        ok(LLMResponse {
          content: value.get_string(parsed, "content") ?? "",
          model: value.get_string(parsed, "model") ?? "",
          usage: Usage {
            prompt_tokens: value.get_int(usage_obj, "prompt_tokens") ?? 0,
            completion_tokens: value.get_int(usage_obj, "completion_tokens") ?? 0,
            total_tokens: value.get_int(usage_obj, "total_tokens") ?? 0,
          },
          finish_reason: value.get_string(parsed, "finish_reason") ?? "stop",
          tool_calls: tool_calls,
          sampling: sampling_of(opts),
        })
      }
    }
  }
}

test "messages_to_json" {
  let j = json.stringify(messages_to_json([Message { role: "user", content: "hi" }]))
  assert(string.contains(j, "user"))
}

test "parse_tool_calls empty" { assert_eq(list.len(parse_tool_calls(value.object([]))), 0) }
