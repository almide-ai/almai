// almai.providers.azure — Azure OpenAI

import env
import http
import json

type Message = {
  role: String,
  content: String,
  tool_call_id: String = "",
  tool_calls: List[ToolCall] = [],
}
type LLMResponse = { content: String, model: String, usage: Usage, finish_reason: String, tool_calls: List[ToolCall], sampling: Sampling }
type Sampling = {
  temperature_sent: Bool = false,
  temperature: Float = 0.0,
  top_p_sent: Bool = false,
  top_p: Float = 0.0,
  max_tokens_sent: Bool = false,
  max_tokens: Int = 0,
  seed_sent: Bool = false,
  seed: Int = 0,
}
type Usage = { prompt_tokens: Int, completion_tokens: Int, total_tokens: Int }
type ToolCall = { id: String, name: String, arguments: String }
type Tool = { name: String, description: String, parameters: Value }
type CallOptions = { max_tokens: Int, temperature: Float, top_p: Float, system: String, stop: List[String], tools: List[Tool], json_mode: Bool, seed: Int = 0 }

// What the body below actually carries: max_tokens only. temperature,
// top_p and seed are not written, so they report unsent rather than
// looking honoured.
fn sampling_of(opts: CallOptions) -> Sampling =
  Sampling { max_tokens_sent: true, max_tokens: opts.max_tokens }

fn messages_to_json(msgs: List[Message]) -> Value =
  value.array(list.map(msgs, (m) =>
    value.object([("role", value.string(m.role)), ("content", value.string(m.content))])))

fn tools_to_json(ts: List[Tool]) -> Value =
  value.array(list.map(ts, (t) =>
    value.object([("type", value.string("function")), ("function", value.object([
      ("name", value.string(t.name)), ("description", value.string(t.description)), ("parameters", t.parameters)]))])))

fn parse_tool_calls(msg: Value) -> List[ToolCall] =
  value.get_array(msg, "tool_calls") ?? []
    |> list.filter_map((tc) => {
      let func = value.get(tc, "function") ?? value.null()
      let name = value.get_string(func, "name") ?? ""
      if name != "" then some(ToolCall { id: value.get_string(tc, "id") ?? "",
        name: name, arguments: value.get_string(func, "arguments") ?? "{}" }) else none
    })

effect fn require_env(key: String) -> Result[String, String] =
  match env.get(key) { some(v) => if v == "" then err("empty env: " + key) else ok(v), none => err("missing env: " + key) }

effect fn call(model: String, msgs: List[Message], opts: CallOptions) -> Result[LLMResponse, String] = {
  let api_key = require_env("AZURE_OPENAI_API_KEY")!
  let endpoint = require_env("AZURE_OPENAI_ENDPOINT")!
  let sys_msgs = if opts.system != "" then [Message { role: "system", content: opts.system }] else []
  let url = endpoint + "/openai/deployments/" + model + "/chat/completions?api-version=2024-06-01"
  let fields = [("messages", messages_to_json(sys_msgs + msgs)), ("max_tokens", value.int(opts.max_tokens))]
  let fields = if not list.is_empty(opts.tools) then fields + [("tools", tools_to_json(opts.tools))] else fields
  let raw = http.request("POST", url, json.stringify(value.object(fields)), [("api-key", api_key), ("Content-Type", "application/json")])
    |> result.map_err((e) => "azure: http: " + e)!
  let parsed = json.parse(raw) |> result.map_err((e) => "azure: json: " + e)!
  ok(response_of(parsed, model, opts))
}

fn response_of(parsed: Value, model: String, opts: CallOptions) -> LLMResponse = {
  let choice = option.flat_map(value.get_array(parsed, "choices"), (cs) => list.first(cs)) ?? value.null()
  let msg = value.get(choice, "message") ?? value.null()
  let u = value.get(parsed, "usage") ?? value.null()
  LLMResponse { content: string.trim(value.get_string(msg, "content") ?? ""),
    model: model, usage: Usage { prompt_tokens: value.get_int(u, "prompt_tokens") ?? 0,
      completion_tokens: value.get_int(u, "completion_tokens") ?? 0,
      total_tokens: value.get_int(u, "total_tokens") ?? 0 },
    finish_reason: value.get_string(choice, "finish_reason") ?? "stop",
    tool_calls: parse_tool_calls(msg), sampling: sampling_of(opts) }
}
