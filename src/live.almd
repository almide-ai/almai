// almai.live — a model call you can watch, stop, and bound in time.
//
// An agent needs more than a call that blocks: to show the answer while it is written,
// to stop it on Esc, to give up on a stream gone quiet, and to start a second copy of a
// request that is not arriving. `start` / `is_done` / `text_so_far` / `cancel` /
// `finish` do that step by step; `run(req, limits, hedge_ms, cap_ms)` all at once.
//
// An HTTP request is a call handle of the runtime's (`http.start`): it is bounded by
// `total` for the whole request and `idle` for a stream that stops talking, it can be
// looked at without waiting, and it is closed on cancel. What arrives is kept in a file
// as it comes, so the answer so far can be read at any point. claude -p runs as a program
// in the background, writing to files. Every chat request is streamed: a non-streamed
// Cloudflare request past about four minutes is ended with `408`. Credentials go in the
// request's headers, never on a command line or in a file.
//
// Where a model id goes is almai.route; the formats themselves are the pure wire_*
// modules. Messages and tools are in the OpenAI chat shape, whatever the model.

import env
import fs
import process
import http
import self.core as core
import self.route as route
import self.wire as wire
import self.wire_openai as wire_openai
import self.wire_anthropic as wire_anthropic
import self.wire_gemini as wire_gemini
import self.wire_claude as wire_claude
import self.answer as answer

// ── Types ──

// `messages` and `tools` are in the OpenAI chat-completions shape. `effort` is the
// reasoning effort, sent where the service takes it ("" sends none). `schema`, when
// given, is the JSON Schema the answer must follow. `session` is a file that keeps a
// claude -p session between calls ("" for none: every call starts afresh).
type Request = {
  model: String,
  messages: List[Value],
  tools: List[Value] = [],
  max_tokens: Int = 4096,
  effort: String = "",
  schema: Value? = none,
  session: String = "",
}

type ToolCall = { id: String, name: String, arguments: String }

// `finish` is normalised and `raw_finish` is the provider's own word. `usage` and `cost`
// are almai.core's: counts the provider did not report stay unknown, and the cost says
// where it came from. `warnings` are what this call could not honour.
type Reply = { content: String, reasoning: String, calls: List[ToolCall], finish: core.Finish, raw_finish: String,
  usage: core.Usage, cost: core.Cost, warnings: List[String], ms: Int }

// `total_s` bounds the whole request; `idle_s` ends a stream that sends nothing that long.
type Limits = { total_s: Int, idle_s: Int }

fn limits() -> Limits = Limits { total_s: 900, idle_s: 120 }

// A request in flight. An HTTP one holds its `call`, and `stream` is what has arrived of
// it so far. A claude -p one is a program in the background, and its shell appends the
// exit status to `out` when it is really finished, which is what "done" means -- the
// stream having stopped growing does not. `id` tells a hedge from the request it copies.
type Pending = { id: Int, call: http.HttpCall?, sh_pid: Int, pid_file: String, stream: String, cfg: String, body: String, out: String, err: String,
  t0: Int, model: String, kind: String, session: String, sent: Int, limits: Limits, tools: Bool, schema_tool: Bool, warnings: List[String] }

// Where a model id goes lives in almai.route; these keep the names callers use.
fn split_model(spec: String) -> (String, String) = route.split_model(spec)

effect fn endpoint(spec: String) -> Result[route.Endpoint, String] = route.endpoint(spec)

// ── The request ──

fn ask_of(ep: route.Endpoint, req: Request) -> wire.Ask =
  wire.Ask { model_id: ep.model_id, provider: ep.provider, messages: req.messages, tools: req.tools, max_tokens: req.max_tokens, effort: req.effort, schema: req.schema }

fn encode(ep: route.Endpoint, req: Request) -> wire.Encoded =
  if ep.kind == "anthropic" then wire_anthropic.encode(ask_of(ep, req))
  else if ep.kind == "gemini" then wire_gemini.encode(ask_of(ep, req))
  else wire_openai.encode(ask_of(ep, req))

// ── The answer ──

fn reply_of(f: wire.Folded, ep: route.Endpoint, ms: Int, warnings: List[String]) -> Reply = {
  let calls = list.map(list.filter(f.calls, (c) => c.name != ""), (c) => ToolCall { id: c.id, name: c.name, arguments: c.arguments })
  Reply { content: f.content, reasoning: f.reasoning, calls: calls, finish: core.settled_finish(f.finish, not list.is_empty(calls)), raw_finish: f.finish,
    usage: f.usage, cost: route.cost_of(f.meter, f.usage, ep), warnings: warnings, ms: ms }
}

// ── In flight ──

effect fn temp(prefix: String) -> Result[String, core.LlmError] = fs.create_temp_file(prefix) |> result.map_err((e) => core.ErrConfig("temp file: " + e))

fn sh_quote(s: String) -> String = "'" + string.replace(s, "'", "'\\''") + "'"

effect fn start(req: Request, l: Limits) -> Result[Pending, core.LlmError] = {
  let ep = endpoint(req.model) |> result.map_err((e) => core.ErrConfig(e))!
  let fresh = Pending { id: 1, call: none, sh_pid: 0, pid_file: "", stream: temp("almai-stream")!, cfg: "", body: "", out: "", err: "",
    t0: env.millis(), model: req.model, kind: ep.kind, session: req.session, sent: list.len(req.messages) + 1, limits: l,
    tools: not list.is_empty(req.tools), schema_tool: ep.kind == "anthropic" and wire_anthropic.schema_as_tool(ask_of(ep, req)), warnings: [] }
  if ep.kind == "claude" then start_claude(req, ep, fresh) else start_http(req, ep, fresh)
}

effect fn start_http(req: Request, ep: route.Endpoint, p: Pending) -> Result[Pending, core.LlmError] = {
  let encoded = encode(ep, req)
  let limits = http.HttpLimits { total_ms: p.limits.total_s * 1000, idle_ms: p.limits.idle_s * 1000 }
  let call = http.start("POST", ep.url, encoded.body, headers_of(ep), limits) |> result.map_err((e) => core.ErrTransport(e))!
  ok({ ...p, call: some(call), warnings: encoded.warnings })
}

// The endpoint's `Name: value` headers, and the body's type.
fn headers_of(ep: route.Endpoint) -> Map[String, String] = {
  var m: Map[String, String] = ["Content-Type": "application/json"]
  for h in ep.headers {
    match string.split_once(h, ":") { some((k, v)) => map.insert(m, string.trim(k), string.trim(v)), none => () }
  }
  m
}

effect fn start_claude(req: Request, ep: route.Endpoint, p: Pending) -> Result[Pending, core.LlmError] = {
  let cfg_path = temp("almai-cfg")!
  let body_path = temp("almai-body")!
  let out_path = temp("almai-out")!
  let err_path = temp("almai-err")!
  let pid_path = temp("almai-pid")!
  let session = if req.session == "" then none else wire_claude.continuing(wire_claude.session_of(fs.read_text(req.session) ?? ""), list.len(req.messages), req.model)
  let (resume, from) = match session { some(s) => (s.id, s.sent), none => ("", 0) }
  fs.write(body_path, wire_claude.prompt(req.messages, from, resume == "")) |> result.map_err((e) => core.ErrConfig("write request: " + e))!
  fs.write(cfg_path, wire_claude.system(req.messages, req.tools)) |> result.map_err((e) => core.ErrConfig("write request: " + e))!
  // From the temp directory, so no project file of the person's is read as memory and
  // the sessions are filed apart from theirs. The program runs in the background so its
  // own pid is known: killing the shell alone would leave it running.
  let script = "cd \"$" + "{TMPDIR:-/tmp}\" && (" + string.join(list.map(wire_claude.args(ep.model_id, resume, cfg_path, if list.is_empty(req.tools) then req.schema else none, req.session != ""), sh_quote), " ") + ") < " + sh_quote(body_path)
    + " > " + sh_quote(p.stream) + " 2> " + sh_quote(err_path) + " & p=$!; echo $p > " + sh_quote(pid_path) + "; wait $p; " + "printf '200\\n%s\\n' \"$?\" > " + sh_quote(out_path)
  let pid = process.spawn("sh", ["-c", script]) |> result.map_err((e) => core.ErrTransport("spawn: " + e))!
  ok({ ...p, sh_pid: pid, pid_file: pid_path, cfg: cfg_path, body: body_path, out: out_path, err: err_path, warnings: wire_claude.warnings(ask_of(ep, req)) })
}

// `out` is the HTTP status with no newline, then the exit status on its own line.
fn exit_of(out: String) -> (Int, Int)? = {
  let lines = string.split(out, "\n")
  if list.len(lines) < 2 then none
  else match int.parse(string.trim(list.get(lines, 1) ?? "")) {
    ok(code) => some((int.parse(string.trim(list.get(lines, 0) ?? "")) ?? 0, code)),
    err(_) => none,
  }
}

effect fn is_done(p: Pending) -> Bool = match p.call {
  some(c) => option.is_some(http.poll(c)),
  none => option.is_some(exit_of(fs.read_text(p.out) ?? "")),
}

// What the model has written so far, from the chunks that arrived whole. claude -p
// answers all at once, so "" until then.
effect fn text_so_far(p: Pending) -> String = match p.call {
  none => "",
  some(c) => {
    let _ = fs.append(p.stream, http.read_new(c))
    match answer.fold_as(p.kind, p.schema_tool, wire.whole_lines(fs.read_text(p.stream) ?? "")) {
      ok(f) => f.content,
      err(_) => "",
    }
  },
}

effect fn clean_up(p: Pending) -> Unit = {
  for f in list.filter([p.stream, p.cfg, p.body, p.out, p.err, p.pid_file], (f) => f != "") { let _ = fs.remove(f) }
  ()
}

// Stop it: the connection closed, or the program and then the shell waiting on it.
effect fn cancel(p: Pending) -> Unit = {
  match p.call {
    some(c) => http.cancel(c),
    none => {
      match int.parse(string.trim(fs.read_text(p.pid_file) ?? "")) {
        ok(pid) => if process.is_alive(pid) then { let _ = process.kill(pid, 15); () },
        err(_) => (),
      }
      if process.is_alive(p.sh_pid) then { let _ = process.kill(p.sh_pid, 15); () }
    },
  }
  clean_up(p)!
}

// What the finished request amounts to. Call once `is_done` says so. A failure is an
// almai.core.LlmError; `core.error_text` words it in the shapes callers matched before:
// `status NNN: ...`, `transport: ...`, `request timeout: ...`.
// (No `!` on the Unit and Bool effect calls in the functions that fail with a
// core.LlmError: almide#2635, `!` there passes check and fails in rustc.)
effect fn finish(p: Pending) -> Result[Reply, core.LlmError] = match p.call {
  none => finish_claude(p),
  some(c) => {
    let answered = http.wait(c)
    let ms = env.millis() - p.t0
    let _ = clean_up(p)
    match answered {
      err(e) => err(answer.call_failure(e)),
      ok(r) => match answer.read_http(answer.Shape { kind: p.kind, schema_tool: p.schema_tool }, http.status_code(r), http.body(r), core.retry_after_in(retry_headers(r))) {
        ok((f, cut_short)) => ok(reply_of(f, endpoint(p.model) ?? route.Endpoint { kind: "chat", provider: "", url: "", headers: [], model_id: "" }, ms,
          p.warnings + cut_short)),
        err(e) => err(e),
      },
    }
  },
}

// The two headers a rate limit's wait is read from, in core.retry_after_in's shape.
fn retry_headers(r: HttpResponse) -> String =
  string.join(list.filter_map(["retry-after-ms", "retry-after"], (k) => option.map(http.get_header(r, k), (v) => k + ": " + v)), "\n")

// claude -p's answer, and its session kept for the next call.
effect fn finish_claude(p: Pending) -> Result[Reply, core.LlmError] = {
  let (_, code) = exit_of(fs.read_text(p.out) ?? "") ?? (0, 0)
  let text = fs.read_text(p.stream) ?? ""
  let said = string.trim(fs.read_text(p.err) ?? "")
  let ms = env.millis() - p.t0
  let _ = clean_up(p)
  match wire_claude.read(text, code, said, p.tools) {
    ok((f, sid)) => {
      if p.session != "" and sid != "" then { let _ = fs.write(p.session, wire_claude.session_text(wire_claude.Session { id: sid, sent: p.sent, model: p.model })); () }
      ok(reply_of(f, route.Endpoint { kind: "claude", provider: "claude", url: "", headers: [], model_id: "" }, ms, p.warnings))
    },
    err(e) => err(e),
  }
}

// ── All at once ──

// `hedged`: a second, identical request was started because the first was slow;
// `won_by_hedge`: that second one is the answer. A hedge that never wins is pure waste,
// and only these say so.
type Ran = { reply: Reply, hedged: Bool, won_by_hedge: Bool }

let POLL_MS = 250

// The request, waited for. Past `hedge_ms` (0: never) a second copy is started and the
// first answer to land is used; claude -p is never hedged, a second copy only spends the
// same login's rate limit twice. Past `cap_ms` (0: only `limits`) both are stopped: a
// model that keeps talking is never idle, so `idle_s` cannot catch it.
effect fn run(req: Request, l: Limits, hedge_ms: Int, cap_ms: Int) -> Result[Ran, core.LlmError] = {
  let t0 = env.millis()
  let hard = (l.total_s + 30) * 1000
  let deadline = if cap_ms > 0 then int.min(cap_ms, hard) else hard
  let first = start(req, l)!
  let (winner, second) = race(req, l, first, if first.kind == "claude" then 0 else hedge_ms, t0, deadline)!
  let started = match second { some(s) => [first, s], none => [first] }
  match winner {
    none => {
      let _ = cancel_all(started)
      err(core.ErrTimeout("no complete answer within " + int.to_string(deadline / 1000) + "s"))
    },
    some(w) => {
      let _ = cancel_all(list.filter(started, (p) => p.id != w.id))
      let r = finish(w)!
      ok(Ran { reply: r, hedged: option.is_some(second), won_by_hedge: w.id != first.id })
    },
  }
}

// Poll until a copy is done, starting the second one past `hedge_at` (0: never): the
// copy that finished, if any did before the deadline, and the second, if it started.
effect fn race(req: Request, l: Limits, first: Pending, hedge_at: Int, t0: Int, deadline: Int) -> Result[(Pending?, Pending?), core.LlmError] = {
  var second: Pending? = none
  var winner: Pending? = none
  var timed_out = false
  while option.is_none(winner) and not timed_out {
    let waited = env.millis() - t0
    winner = done_of(first, second) ?? none
    if option.is_none(winner) and option.is_none(second) and hedge_at > 0 and waited > hedge_at then { second = some({ ...start(req, l)!, id: 2 }) }
    if option.is_none(winner) then { if waited > deadline then { timed_out = true } else env.sleep_ms(POLL_MS) }
  }
  ok((winner, second))
}

effect fn done_of(first: Pending, second: Pending?) -> Pending? =
  if is_done(first) ?? false then some(first)
  else match second {
    some(s) => if is_done(s) ?? false then some(s) else none,
    none => none,
  }

effect fn cancel_all(ps: List[Pending]) -> Unit = {
  for p in ps { cancel(p)! }
  ()
}
