// almai.core — the types every provider and transport shares.
//
// What a call ended with, what it used and cost, what went wrong, and what the provider
// could not honour. One set, so a caller branches on a variant and not on the wording of
// a string, and so a new provider cannot quietly invent its own. Drawn from four
// libraries (research notes in comide's history, 2026-09-25):
//   - finish reasons normalised, the provider's own word kept (Vercel AI SDK, genai)
//   - usage split into uncached, cache read, cache write, output and reasoning, with a
//     count the provider did not report left unknown rather than 0 (Vercel, LiteLLM)
//   - cost from the provider's own meter first, then a price table, never a guess, and
//     it says which (LiteLLM)
//   - errors as a variant with one retryable() and one place that classifies (LiteLLM,
//     rig), Retry-After carried on a rate limit
//   - warnings for what a provider could not honour, instead of dropping it silently
//     (Vercel)

// ── How a call ended ──

// The cases carry the type's name: an Almide case name is seen by every module in the
// program, even ones that never import this (almide#2636), so a bare `Stop` here broke
// golemide's own `type Stop`.
type Finish = | FinishStop | FinishLength | FinishToolCalls | FinishFiltered | FinishOther(String)

// Every provider's word for it, in one table. A stop that came with tool calls is read
// by the caller as ToolCalls (see `settled_finish`).
let FINISH_WORDS = [
  (["stop", "end_turn", "stop_sequence", "eos", "complete", "finish_reason_stop", ""], FinishStop),
  (["length", "max_tokens", "max_output_tokens", "model_length", "model_context_window_exceeded"], FinishLength),
  (["tool_calls", "tool_use", "function_call", "tool_call"], FinishToolCalls),
  (["content_filter", "safety", "recitation", "refusal", "blocklist", "prohibited_content", "spii", "guardrail_intervened"], FinishFiltered),
]

fn finish_of(raw: String) -> Finish = {
  let r = string.to_lower(string.trim(raw))
  match list.find(FINISH_WORDS, (row) => list.contains(row.0, r)) {
    some(row) => row.1,
    none => FinishOther(raw),
  }
}

fn settled_finish(raw: String, has_calls: Bool) -> Finish = match finish_of(raw) {
  FinishStop => if has_calls then FinishToolCalls else FinishStop,
  f => f,
}

fn finish_name(f: Finish) -> String = match f {
  FinishStop => "stop",
  FinishLength => "length",
  FinishToolCalls => "tool_calls",
  FinishFiltered => "content_filter",
  FinishOther(raw) => raw,
}

// ── What it used, and what it cost ──

// `input` excludes the cached tokens; `output` includes the reasoning ones. none is a
// count the provider did not report, which is not the same as 0.
type Usage = { input: Int?, cache_read: Int?, cache_write: Int?, output: Int?, reasoning: Int? }

fn no_usage() -> Usage = Usage { input: none, cache_read: none, cache_write: none, output: none, reasoning: none }

fn count(n: Int?) -> Int = n ?? 0

// All the input the model read, cached or not.
fn input_total(u: Usage) -> Int = count(u.input) + count(u.cache_read) + count(u.cache_write)

fn add_count(a: Int?, b: Int?) -> Int? = match (a, b) {
  (none, none) => none,
  _ => some(count(a) + count(b)),
}

fn add_usage(a: Usage, b: Usage) -> Usage =
  Usage { input: add_count(a.input, b.input), cache_read: add_count(a.cache_read, b.cache_read), cache_write: add_count(a.cache_write, b.cache_write),
    output: add_count(a.output, b.output), reasoning: add_count(a.reasoning, b.reasoning) }

// `source` is "provider" (its own meter: Cloudflare's neurons, OpenRouter's usage.cost,
// claude's total_cost_usd), "table" (a price table times the usage), or "none" (not known,
// and usd 0.0 -- never a guess).
type Cost = { usd: Float, source: String }

fn no_cost() -> Cost = Cost { usd: 0.0, source: "none" }

fn add_cost(a: Cost, b: Cost) -> Cost =
  Cost { usd: a.usd + b.usd, source: if a.source == b.source then a.source else if a.source == "none" then b.source else if b.source == "none" then a.source else "mixed" }

// ── What went wrong ──

type LlmError =
  | ErrConfig(String)            // no key, unknown provider: nothing was sent
  | ErrRateLimited(Int, String)  // retry after this many ms (0: not said), and what the provider said
  | ErrOverloaded(Int, String)   // 5xx, 529, "overloaded": the provider, not the request
  | ErrTimeout(String)           // no answer in time, or a stream that went quiet
  | ErrTransport(String)         // the network: DNS, refused, reset
  | ErrContextTooLong(String)    // the request is bigger than the model takes
  | ErrContentFiltered(String)   // refused on policy
  | ErrAuth(Int, String)         // 401 / 403
  | ErrNotFound(Int, String)     // 404: usually the model id
  | ErrBadRequest(Int, String)   // 400 / 422 and the like: the request itself
  | ErrCancelled
  | ErrTruncated(String)         // the answer stopped before its end
  | ErrUnreadable(String)        // a reply that could not be read
  | ErrOther(Int, String)

// Worth trying the same request again, as it is.
fn retryable(e: LlmError) -> Bool = match e {
  ErrRateLimited(_, _) => true,
  ErrOverloaded(_, _) => true,
  ErrTimeout(_) => true,
  ErrTransport(_) => true,
  ErrOther(status, _) => status == 408 or status == 409 or status == 425,
  _ => false,
}

// Not worth retrying here, but worth another model: a bigger context, another family.
fn wants_fallback(e: LlmError) -> Bool = match e {
  ErrContextTooLong(_) => true,
  ErrContentFiltered(_) => true,
  ErrNotFound(_, _) => true,
  _ => retryable(e),
}

fn has_any(body: String, needles: List[String]) -> Bool = {
  let b = string.to_lower(body)
  list.any(needles, (n) => string.contains(b, n))
}

// One place that reads a failed HTTP reply, as a table tried in order: a row matches
// on its status or on words in the body. The body counts first for the causes that
// come under the wrong status -- a context overflow under 400, a rate limit under 400
// or 503, an unknown model under Cloudflare's 400 and "No such model". Any other 5xx is
// the provider overloaded.
let CAUSES = [
  ("context", [], ["context_length_exceeded", "context window", "maximum context length", "prompt is too long", "too many tokens", "input is too long", "exceeds the context", "reduce the length"]),
  ("filtered", [], ["content_filter", "content policy", "content_policy", "safety system", "responsibleaipolicyviolation", "flagged"]),
  ("rate", [429], ["rate limit", "rate_limit", "too many requests", "quota exceeded", "capacity exceeded"]),
  ("overloaded", [529], ["overloaded", "server is busy", "service unavailable"]),
  ("auth", [401, 403], []),
  ("not_found", [404], ["no such model", "model not found", "model_not_found", "does not exist or you do not have access"]),
  ("timeout", [408, 504], []),
  ("bad_request", [400, 422, 413], []),
]

fn cause_of(status: Int, body: String) -> String =
  match list.find(CAUSES, (c) => list.contains(c.1, status) or has_any(body, c.2)) {
    some(c) => c.0,
    none => if status >= 500 then "overloaded" else "other",
  }

fn classify(status: Int, body: String, retry_after_ms: Int) -> LlmError = {
  let said = string.take(string.trim(body), 500)
  match cause_of(status, body) {
    "context" => ErrContextTooLong(said),
    "filtered" => ErrContentFiltered(said),
    "rate" => ErrRateLimited(retry_after_ms, said),
    "overloaded" => ErrOverloaded(status, said),
    "auth" => ErrAuth(status, said),
    "not_found" => ErrNotFound(status, said),
    "timeout" => ErrTimeout("status " + int.to_string(status) + ": " + said),
    "bad_request" => ErrBadRequest(status, said),
    _ => ErrOther(status, said),
  }
}

// The HTTP status a failure came with, and what the provider said.
fn status_of(e: LlmError) -> (Int, String)? = match e {
  ErrRateLimited(_, said) => some((429, said)),
  ErrOverloaded(status, said) => some((status, said)),
  ErrAuth(status, said) => some((status, said)),
  ErrNotFound(status, said) => some((status, said)),
  ErrBadRequest(status, said) => some((status, said)),
  ErrOther(status, said) => some((status, said)),
  _ => none,
}

// The failures that did not come as an HTTP status.
fn plain_text(e: LlmError) -> String = match e {
  ErrConfig(m) => m,
  ErrTimeout(m) => "request timeout: " + m,
  ErrTransport(m) => "transport: " + m,
  ErrContextTooLong(said) => "context too long: " + said,
  ErrContentFiltered(said) => "content filtered: " + said,
  ErrCancelled => "cancelled",
  ErrTruncated(m) => "truncated: " + m,
  ErrUnreadable(m) => "unreadable answer: " + m,
  _ => "",
}

// The error as text, in the shapes callers already match on: "status NNN: ...",
// "transport: ...", "request timeout: ...".
fn error_text(e: LlmError) -> String = match status_of(e) {
  some((status, said)) => "status " + int.to_string(status) + ": " + said + match e {
    ErrRateLimited(ms, _) => if ms > 0 then " (retry after " + int.to_string(ms) + "ms)" else "",
    _ => "",
  },
  none => plain_text(e),
}

// Retry-After, as seconds or an HTTP date; the date form is read as "not said".
fn retry_after_of(value: String) -> Int = match int.parse(string.trim(value)) {
  ok(s) => if s > 0 and s <= 3600 then s * 1000 else 0,
  err(_) => 0,
}

// retry-after-ms (OpenAI, Anthropic) wins over retry-after.
fn retry_after_in(headers: String) -> Int = {
  var ms = 0
  var secs = 0
  for line in string.split(headers, "\n") {
    match string.split_once(line, ":") {
      some((k, v)) => {
        let key = string.to_lower(string.trim(k))
        if key == "retry-after-ms" then { ms = int.parse(string.trim(v)) ?? 0 }
        else if key == "retry-after" then { secs = retry_after_of(v) }
      },
      none => (),
    }
  }
  if ms > 0 then ms else secs
}

test "every provider's finish word lands on one of five" {
  assert_eq(finish_of("end_turn"), FinishStop)
  assert_eq(finish_of("MAX_TOKENS"), FinishLength)
  assert_eq(finish_of("tool_use"), FinishToolCalls)
  assert_eq(finish_of("SAFETY"), FinishFiltered)
  assert_eq(finish_of("pause_turn"), FinishOther("pause_turn"))
  assert_eq(settled_finish("stop", true), FinishToolCalls)
  assert_eq(finish_name(FinishOther("pause_turn")), "pause_turn")
}

test "usage adds up, and what was never reported stays unknown" {
  let a = Usage { input: some(100), cache_read: some(40), cache_write: none, output: some(20), reasoning: none }
  let b = Usage { input: some(10), cache_read: none, cache_write: none, output: some(5), reasoning: none }
  let s = add_usage(a, b)
  assert_eq((s.input, s.cache_read, s.cache_write, s.output), (some(110), some(40), none, some(25)))
  assert_eq(input_total(s), 150)
  assert_eq(add_cost(Cost { usd: 0.1, source: "provider" }, no_cost()).source, "provider")
}

test "a failed reply is classified by its body first, then its status" {
  assert_eq(classify(400, "{\"error\":{\"code\":\"context_length_exceeded\"}}", 0), ErrContextTooLong("{\"error\":{\"code\":\"context_length_exceeded\"}}"))
  assert_eq(classify(429, "slow down", 2000), ErrRateLimited(2000, "slow down"))
  assert_eq(classify(503, "rate limit reached", 0), ErrRateLimited(0, "rate limit reached"))
  assert_eq(classify(529, "{\"type\":\"overloaded_error\"}", 0), ErrOverloaded(529, "{\"type\":\"overloaded_error\"}"))
  assert_eq(classify(401, "bad key", 0), ErrAuth(401, "bad key"))
  assert(retryable(classify(502, "bad gateway", 0)))
  assert(retryable(classify(409, "conflict", 0)))
  assert(not retryable(classify(400, "invalid json", 0)))
  assert_eq(classify(400, "AiError: No such model @cf/x", 0), ErrNotFound(400, "AiError: No such model @cf/x"))
  assert(not retryable(ErrContextTooLong("x")) and wants_fallback(ErrContextTooLong("x")))
  assert_eq(error_text(classify(429, "slow down", 0)), "status 429: slow down")
  assert_eq(error_text(ErrTransport("curl exit 6")), "transport: curl exit 6")
}

test "Retry-After is read in milliseconds, or seconds, and a date is not said" {
  assert_eq(retry_after_in("HTTP/2 429\nretry-after: 7\ncontent-type: x\n"), 7000)
  assert_eq(retry_after_in("Retry-After-Ms: 1500\nRetry-After: 2\n"), 1500)
  assert_eq(retry_after_in("retry-after: Wed, 21 Oct 2026 07:28:00 GMT\n"), 0)
}
