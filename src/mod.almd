// almai — Multi-provider LLM client for Almide
//
// Usage:
//   import almai
//
//   let r = almai.call("anthropic/claude-sonnet-4-6", [
//     almai.system("You are helpful."),
//     almai.user("Hello"),
//   ])!
//   println(r.content)
//
// Providers: anthropic/, openai/, openrouter/, groq/, cf/, azure/, google/, cli/
// Submodules: almai.tools, almai.conv, almai.providers.*

import env
import int
import json
import self.providers.openai as openai_provider
import self.providers.anthropic as anthropic_provider
import self.providers.cloudflare as cf_provider
import self.providers.azure as azure_provider
import self.providers.google as google_provider
import self.providers.bedrock as bedrock_provider
import self.providers.cli as cli_provider

// ── Core types ──

type Message = {
  role: String,
  content: String,
  // Set on role:"tool" messages so providers (OpenAI / Anthropic) can
  // correlate the result back to the assistant's tool_use call. Empty
  // string means "not a tool result".
  tool_call_id: String = "",
  // Set on role:"assistant" messages that the model emitted with tool
  // calls. Carrying these through history is what lets providers see
  // the proper assistant → tool_result roundtrip.
  tool_calls: List[ToolCall] = [],
}

type LLMResponse = {
  content: String,
  model: String,
  usage: Usage,
  finish_reason: String,
  tool_calls: List[ToolCall],
  // What the provider ACTUALLY put on the wire for this call. Deliberately
  // NOT defaulted: a field a provider may quietly leave blank is the same
  // shape as the bug this fixes — a declaration nobody honours. Making it
  // mandatory means a new provider has to answer "what did you send?"
  // before it compiles. Never infer "the model honoured X" from
  // CallOptions; read this.
  sampling: Sampling,
}

// Sampling echo: the request-side half of reproducibility.
//
// `*_sent` says the field was written into the request body, NOT that the
// model honoured it. No text-generation API reports back which sampling
// controls it actually applied, so "honoured" can only be established
// empirically: run the same (model, seed, temperature, task set) twice and
// compare. A manifest can therefore print `seed: 7` when `seed_sent` is
// true, and `seed: null` when it is false — and, when two runs with
// `seed_sent: true` disagree, record that THIS model ignored the seed.
//
// The point of the record is that the two cases stop looking alike: before
// it, a caller could not tell a pinned run from an unpinned one.
type Sampling = {
  temperature_sent: Bool = false,
  temperature: Float = 0.0,
  top_p_sent: Bool = false,
  top_p: Float = 0.0,
  max_tokens_sent: Bool = false,
  max_tokens: Int = 0,
  seed_sent: Bool = false,
  seed: Int = 0,
}

type Usage = { prompt_tokens: Int, completion_tokens: Int, total_tokens: Int }
type ToolCall = { id: String, name: String, arguments: String }
type Tool = { name: String, description: String, parameters: Value }

type CallOptions = {
  max_tokens: Int,
  temperature: Float,
  top_p: Float,
  system: String,
  stop: List[String],
  tools: List[Tool],
  json_mode: Bool,
  // 0 = unset, so a caller who never asked for a seed never gets one
  // silently pinned. 0 is safe as the sentinel because Cloudflare Workers
  // AI documents the valid seed range as 1..=9_999_999_999, so 0 can never
  // be a legitimate seed. Set it with `with_seed`.
  seed: Int = 0,
}

// ── Message constructors ──

fn system(content: String) -> Message = Message { role: "system", content: content }
fn user(content: String) -> Message = Message { role: "user", content: content }
fn assistant(content: String) -> Message = Message { role: "assistant", content: content }
fn assistant_with_tools(content: String, tool_calls: List[ToolCall]) -> Message =
  Message { role: "assistant", content: content, tool_calls: tool_calls }
fn tool_result(tool_call_id: String, content: String) -> Message =
  Message { role: "tool", content: content, tool_call_id: tool_call_id }

// ── Options builder ──

// `temperature: 0.0` is the measurement default, and it is a deliberate
// choice, not an inherited zero value: almai is the transport for the MSR
// numbers that go in almide's README, and a benchmark that resamples the
// model on every run measures the sampler as much as the language. Callers
// who want prose, not measurement, opt in with `with_temperature`.
//
// It also has to be SENT to mean anything: a provider that drops it falls
// back to the vendor's own default, which is not 0 (Cloudflare Workers AI
// documents 0.6). That is the exact defect almide-ai/almai#7 records.
//
// `seed: 0` means unset. There is deliberately no default seed: pinning one
// here would make every caller's runs silently correlated, and a seed the
// caller did not choose is not reproducibility, it is a hidden constant.
fn defaults() -> CallOptions =
  CallOptions { max_tokens: 4096, temperature: 0.0, top_p: 1.0, system: "", stop: [], tools: [], json_mode: false, seed: 0 }

fn with_max_tokens(opts: CallOptions, n: Int) -> CallOptions = { ...opts, max_tokens: n }
fn with_temperature(opts: CallOptions, t: Float) -> CallOptions = { ...opts, temperature: t }
fn with_top_p(opts: CallOptions, p: Float) -> CallOptions = { ...opts, top_p: p }
fn with_system(opts: CallOptions, s: String) -> CallOptions = { ...opts, system: s }
fn with_stop(opts: CallOptions, sequences: List[String]) -> CallOptions = { ...opts, stop: sequences }
fn with_tools(opts: CallOptions, ts: List[Tool]) -> CallOptions = { ...opts, tools: ts }
fn with_json_mode(opts: CallOptions) -> CallOptions = { ...opts, json_mode: true }
// Pin the sampler. Cloudflare Workers AI accepts 1..=9_999_999_999; passing
// 0 means "no seed" (see CallOptions.seed). Whether the model then honours
// it is a per-model fact — check `r.sampling.seed_sent` for what went out,
// and two identical runs for whether it was respected.
fn with_seed(opts: CallOptions, n: Int) -> CallOptions = { ...opts, seed: n }

// ── Provider parsing ──

fn parse_provider(model_spec: String) -> (String, String) = {
  let idx = string.index_of(model_spec, "/") |> option.unwrap_or(-1)
  if idx < 0 then ("openai", model_spec)
  else (string.take(model_spec, idx), string.drop(model_spec, idx + 1))
}

// ── Internal ──

effect fn require_env(key: String) -> Result[String, String] =
  match env.get(key) {
    some(v) => if v == "" then err("empty env: " + key) else ok(v)
    none => err("missing env: " + key)
  }

// ── Public API ──

effect fn call(model_spec: String, msgs: List[Message]) -> Result[LLMResponse, String] =
  call_with(model_spec, msgs, defaults())

// Streaming variant of `call_with`. Token-level deltas are delivered to
// the `on_text_delta` callback as they arrive; the final aggregated
// LLMResponse comes back via the Result.
//
// Provider support: openai, openrouter, groq (all via the shared OpenAI
// SSE wrapper). Other providers fall back with an explicit error so the
// caller can choose to retry via the non-streaming `call_with`.
effect fn call_streaming(model_spec: String, msgs: List[Message], opts: CallOptions, on_text_delta: (String) -> Unit) -> Result[LLMResponse, String] = {
  let (provider, model) = parse_provider(model_spec)
  if provider == "anthropic" then anthropic_provider.call_streaming(model, msgs, opts, on_text_delta)
  else match compatible(provider) {
    some((base, key_env)) => match require_env(key_env) {
      ok(key) => openai_provider.call_streaming(base, key, model, msgs, opts, on_text_delta),
      err(e) => err(e),
    },
    none => err("call_streaming: provider '${provider}' does not support streaming yet (use call_with for non-streaming)"),
  }
}

// The OpenAI-compatible services: their base URL and the variable holding the key.
let OPENAI_COMPATIBLE = [
  ("openai", "https://api.openai.com/v1", "OPENAI_API_KEY"),
  ("openrouter", "https://openrouter.ai/api/v1", "OPENROUTER_API_KEY"),
  ("groq", "https://api.groq.com/openai/v1", "GROQ_API_KEY"),
]

fn compatible(provider: String) -> (String, String)? =
  option.map(list.find(OPENAI_COMPATIBLE, (c) => c.0 == provider), (c) => (c.1, c.2))

effect fn call_with(model_spec: String, msgs: List[Message], opts: CallOptions) -> Result[LLMResponse, String] = {
  let (provider, model) = parse_provider(model_spec)
  match compatible(provider) {
    some((base, key_env)) => match require_env(key_env) {
      ok(key) => openai_provider.call(base, key, model, msgs, opts),
      err(e) => err(e),
    },
    none => call_native(provider, model, msgs, opts),
  }
}

// The providers with an API of their own.
effect fn call_native(provider: String, model: String, msgs: List[Message], opts: CallOptions) -> Result[LLMResponse, String] =
  match provider {
    "anthropic" => anthropic_provider.call(model, msgs, opts),
    "cf" => cf_provider.call(model, msgs, opts),
    "cloudflare" => cf_provider.call(model, msgs, opts),
    "azure" => azure_provider.call(model, msgs, opts),
    "bedrock" => bedrock_provider.call(model, msgs, opts),
    "google" => google_provider.call(model, msgs, opts),
    "cli" => if model == "claude" then cli_provider.call_claude(msgs, opts)
      else if model == "codex" then cli_provider.call_codex(msgs, opts)
      else err("unknown cli: " + model),
    _ => err("unknown provider: " + provider),
  }

// ── Retry support ──
//
// HTTP 429 / 5xx and connection errors are transient. `call_retry` wraps the
// dispatch in an exponential-backoff loop. Non-retriable errors (auth, malformed
// request, etc.) propagate immediately. Pass `max_attempts: 1` for no retry.

// What a transient failure's message contains.
let RETRIABLE_MARKS = ["408", "409", "429", "529", "overloaded", "500", "502", "503", "504", "timeout", "Timeout", "connection", "Connection"]

fn is_retriable_error(msg: String) -> Bool = list.any(RETRIABLE_MARKS, (m) => string.contains(msg, m))

effect fn retry_loop(
  model_spec: String,
  msgs: List[Message],
  opts: CallOptions,
  attempt: Int,
  max_attempts: Int,
  delay_ms: Int,
) -> Result[LLMResponse, String] =
  match call_with(model_spec, msgs, opts) {
    ok(r) => ok(r)
    err(e) =>
      if attempt >= max_attempts or not is_retriable_error(e) then err(e)
      else {
        env.sleep_ms(delay_ms)
        retry_loop(model_spec, msgs, opts, attempt + 1, max_attempts, delay_ms * 2)
      }
  }

// Call with exponential backoff. Initial delay 1000ms, doubles each retry.
// `max_attempts` includes the first attempt, so 3 means 1 try + 2 retries.
effect fn call_retry(
  model_spec: String,
  msgs: List[Message],
  opts: CallOptions,
  max_attempts: Int,
) -> Result[LLMResponse, String] =
  retry_loop(model_spec, msgs, opts, 1, max_attempts, 1000)

// Call with custom initial backoff delay (ms).
effect fn call_retry_with_delay(
  model_spec: String,
  msgs: List[Message],
  opts: CallOptions,
  max_attempts: Int,
  base_delay_ms: Int,
) -> Result[LLMResponse, String] =
  retry_loop(model_spec, msgs, opts, 1, max_attempts, base_delay_ms)

// ── Response helpers ──

fn has_tool_calls(r: LLMResponse) -> Bool = not list.is_empty(r.tool_calls)
fn first_tool_call(r: LLMResponse) -> Option[ToolCall] = list.first(r.tool_calls)
fn parse_content_as_json(r: LLMResponse) -> Result[Value, String] = json.parse(r.content)
