// Tests of the package root, almai (src/mod.almd).

import json
import self as almai


test "parse_provider with slash" {
  let p = almai.parse_provider("anthropic/claude-sonnet-4-6")
  assert_eq(p.0, "anthropic")
  assert_eq(p.1, "claude-sonnet-4-6")
}

test "parse_provider no slash" {
  let p = almai.parse_provider("gpt-4o")
  assert_eq(p.0, "openai")
  assert_eq(p.1, "gpt-4o")
}

test "parse_provider cf" {
  let p = almai.parse_provider("cf/@cf/meta/llama")
  assert_eq(p.0, "cf")
  assert_eq(p.1, "@cf/meta/llama")
}

test "message constructors" {
  assert_eq(almai.system("s").role, "system")
  assert_eq(almai.user("u").role, "user")
  assert_eq(almai.assistant("a").role, "assistant")
}

test "defaults" {
  let d = almai.defaults()
  assert_eq(d.max_tokens, 4096)
  assert_eq(d.json_mode, false)
}

test "options builder" {
  let opts = almai.defaults() |> almai.with_max_tokens(8192) |> almai.with_system("sys") |> almai.with_json_mode |> almai.with_stop(["END"])
  assert_eq(opts.max_tokens, 8192)
  assert_eq(opts.system, "sys")
  assert_eq(opts.json_mode, true)
  assert_eq(list.len(opts.stop), 1)
}

test "with_seed / seed default" {
  assert_eq(almai.defaults().seed, 0)
  assert_eq((almai.defaults() |> almai.with_seed(7)).seed, 7)
}

test "with_tools" {
  let ts = [almai.Tool { name: "f", description: "d", parameters: value.object([]) }]
  assert_eq(list.len((almai.defaults() |> almai.with_tools(ts)).tools), 1)
}

test "has_tool_calls false" {
  let r = almai.LLMResponse { content: "hi", model: "m",
    usage: almai.Usage { prompt_tokens: 0, completion_tokens: 0, total_tokens: 0 },
    finish_reason: "stop", tool_calls: [], sampling: almai.Sampling { } }
  assert_eq(almai.has_tool_calls(r), false)
}

test "an unfilled sampling echo claims nothing" {
  let s = almai.Sampling { }
  assert_eq(s.seed_sent, false)
  assert_eq(s.temperature_sent, false)
  assert_eq(s.top_p_sent, false)
  assert_eq(s.max_tokens_sent, false)
}

test "is_retriable_error true for HTTP 429" {
  assert(almai.is_retriable_error("HTTP 429: too many requests"), "429")
}

test "is_retriable_error true for HTTP 503" {
  assert(almai.is_retriable_error("HTTP 503 Service Unavailable"), "503")
}

test "is_retriable_error true for timeout" {
  assert(almai.is_retriable_error("request timeout after 30s"), "timeout")
  assert(almai.is_retriable_error("Timeout reached"), "Timeout")
}

test "is_retriable_error false for auth errors" {
  assert(not almai.is_retriable_error("HTTP 401 Unauthorized"), "401")
  assert(not almai.is_retriable_error("HTTP 403 Forbidden"), "403")
  assert(not almai.is_retriable_error("HTTP 400 Bad Request"), "400")
}

test "is_retriable_error false for missing env" {
  assert(not almai.is_retriable_error("missing env: OPENAI_API_KEY"), "missing env")
}

test "parse_content_as_json" {
  let r = almai.LLMResponse { content: "{\"x\":1}", model: "m",
    usage: almai.Usage { prompt_tokens: 0, completion_tokens: 0, total_tokens: 0 },
    finish_reason: "stop", tool_calls: [], sampling: almai.Sampling { } }
  match almai.parse_content_as_json(r) {
    ok(v) => assert_eq(json.get_int(v, "x") |> option.unwrap_or(0), 1)
    err(_) => assert(false)
  }
}

test "is_retriable_error true for 408, 409, 529 and an overloaded provider" {
  assert(almai.is_retriable_error("HTTP 408: request timeout"))
  assert(almai.is_retriable_error("HTTP 409: conflict"))
  assert(almai.is_retriable_error("HTTP 529: {\"type\":\"overloaded_error\"}"))
}
